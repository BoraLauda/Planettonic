    choices: []
  - side: 1
    characterName: Linus
    characterSprite: {fileID: 0}
    sentence: "I don\u2019t doubt that one bit."
    eventTrigger: 
    choices: []
  - side: 0
    characterName: Nemelise
    characterSprite: {fileID: 0}
    sentence: It was the fact that my competition thought my identity was a weak
